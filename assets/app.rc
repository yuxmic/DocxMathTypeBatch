// 程序文件、窗口标题和任务栏共用同一组绿色图标。
#include <winver.h>
#include "../src/app_version.h"
1 ICON "app_icon.ico"

// 文件资源用于连接前识别产品，旧程序无需被启动来探测新参数。
1 VERSIONINFO
FILEVERSION DMTB_VERSION_NUMBERS
PRODUCTVERSION DMTB_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "yuxmic"
            VALUE "FileDescription", "DocxMathTypeBatch"
            VALUE "FileVersion", DMTB_VERSION
            VALUE "InternalName", "DocxMathTypeBatch"
            VALUE "OriginalFilename", "DocxMathTypeBatch.exe"
            VALUE "ProductName", "DocxMathTypeBatch"
            VALUE "ProductVersion", DMTB_VERSION
            VALUE "LegalCopyright", "MIT License - yuxmic"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
